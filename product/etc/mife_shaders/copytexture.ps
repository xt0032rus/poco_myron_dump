precision lowp float;

layout(location=0) in highp vec2 in_TEXCOORD0;
layout(location=0) out lowp vec4 out_Target0;
layout(binding = 0) uniform sampler2D src_texture;
layout(binding = 1) uniform sampler2D ui_texture;

void main() 
{
    vec3 fColor = textureLod(src_texture, in_TEXCOORD0, 0.0).rgb;
    vec4 ui_color = texture(ui_texture, in_TEXCOORD0).rgba;
    fColor = fColor * (1.0 - ui_color.a) + ui_color.rgb;
    if(in_TEXCOORD0.x < 0.05 && in_TEXCOORD0.y < 0.05)
    {
        //fColor.r = 1.0;
    }
    
    out_Target0 = vec4(fColor, 1.0);
}